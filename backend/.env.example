# ─────────────────────────────────────────────────────────────
# Savor Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your environment.
#
# Database (MySQL / TiDB Cloud)
#   DB_HOST     — database hostname (e.g. TiDB Cloud gateway)
#   DB_PORT     — database port (3306 for MySQL, 4000 for TiDB Cloud)
#   DB_USER     — database user
#   DB_PASSWORD — database password
#   DB_NAME     — database name
#   DB_SOCKET   — (optional) local Unix socket path, e.g. for XAMPP
#                 Only set this for local development. When set, it
#                 overrides host/port (mysql2 behaviour).
#   DB_SSL_CA   — (optional) path to CA certificate for TLS/SSL
#                 Required by TiDB Cloud and most managed MySQL hosts.
#
# JWT
#   JWT_SECRET     — secret used to sign JWT tokens
#   JWT_EXPIRES_IN — token expiry (e.g. 7d, 1h)
#
# Server
#   PORT — port the Express server listens on (default 5000)
#
# CORS & Frontend
#   FRONTEND_URL — URL of the deployed frontend (e.g. https://myapp.vercel.app)
#   VERCEL_URL   — automatically set by Vercel (e.g. https://savor-api.vercel.app)
# ─────────────────────────────────────────────────────────────

# ── Production (TiDB Cloud) ──────────────────────────────────
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=Foqp6EwFjH2Y2es.root
DB_PASSWORD=yDEd1y1uNZmtQMTL
DB_NAME=food_db
DB_SSL_CA=/etc/ssl/cert.pem

# ── Local development (XAMPP) — uncomment to use ─────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=food_db
# DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# JWT
JWT_SECRET=savor_secret_key_2026
JWT_EXPIRES_IN=7d

# Server
PORT=5000

# CORS & Frontend (for production)
# FRONTEND_URL=https://your-frontend-app.vercel.app
# VERCEL_URL=https://savor-api.vercel.app