# ─────────────────────────────────────────────────────────────
# Savor Expo App — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your environment.
#
# EXPO_PUBLIC_API_URL
#   The base URL of the Savor backend API (including /api suffix).
#   - Local dev:  http://localhost:5000/api
#   - LAN dev:    http://192.168.1.19:5000/api  (your machine's LAN IP)
#   - Production: https://your-backend.example.com/api
#
#   This variable is inlined at build time by Expo. It MUST be set
#   for production deployments (e.g. Vercel) — the fallback
#   (http://localhost:5000/api) only works for local development.
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://localhost:5000/api
